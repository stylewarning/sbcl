#-(and x86-64 avx512 sb-simd-pack-512) (invoke-restart 'run-tests::skip-file)

(cl:in-package "SB-X86-64-ASM")

(defun avx-test-operand (spec)
  (if (atom spec)
      spec
      (case (car spec)
        ((:xmm :ymm :zmm :k)
         (get-fpr (if (eq (car spec) :k) :kreg (car spec)) (second spec)))
        (:gpr (get-gpr (second spec) (third spec)))
        (:mem (ea (second spec) sb-vm::r13-tn sb-vm::r14-tn 2))
        (:vsib
         (ea
          (second spec) sb-vm::r13-tn
          (sb-c:make-random-tn
           (sb-c:sc-or-lose (ecase (third spec)
                             (:xmm 'sb-vm::double-reg)
                             (:ymm 'sb-vm::double-avx2-reg)
                             (:zmm 'sb-vm::double-avx512-reg)))
           (fourth spec)) 2))
        (t (error "Unknown operand ~S" spec)))))

(defun assemble-avx-test (instruction)
  (let ((segment (sb-assem:make-segment)))
    (sb-assem:assemble (segment nil)
      (apply #'sb-assem:inst* (car instruction) (mapcar #'avx-test-operand (cdr instruction))))
    (subseq (sb-assem:segment-buffer segment) 0
            (sb-assem::segment-current-posn segment))))

(defun avx-test-hex-bytes (bytes)
  (format nil "~{~2,'0X~}" (coerce bytes 'list)))

(defun check-avx-test-boundary (bytes)
  (let ((sb-disassem::*undecoded-bytes* 0)
        (count 0)
        (dstate (sb-disassem:make-dstate nil)))
    (sb-sys:with-pinned-objects (bytes)
      (sb-disassem::map-segment-instructions
       (lambda (chunk inst)
         (declare (ignore chunk inst))
         (incf count)
         (assert (= (sb-disassem:dstate-next-offs dstate) (length bytes)) ()
                 "Wrong boundary for ~A: ~D" (avx-test-hex-bytes bytes)
                 (sb-disassem:dstate-next-offs dstate)))
       (sb-disassem::%make-segment :sap-maker (lambda () (sb-sys:vector-sap bytes))
                                   :length (length bytes) :virtual-location 0)
       dstate))
    (assert (zerop sb-disassem::*undecoded-bytes*))
    (assert (= count 1))))

