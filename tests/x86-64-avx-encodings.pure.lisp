(test-util:with-test (:name :avx-reject-incompatible-evex)
  (dolist (form '((vhaddpd (:zmm 1) (:zmm 2) (:zmm 3))
                 (vblendpd (:zmm 1) (:zmm 2) (:zmm 3) 5)
                 (vblendvpd (:ymm 1) (:ymm 2) (:ymm 3) (:ymm 16))
                 (vmpsadbw (:zmm 1) (:zmm 2) (:zmm 3) 5)
                 (vroundpd (:zmm 1) (:zmm 2) 0)
                 (vperm2f128 (:zmm 1) (:zmm 2) (:zmm 3) 5)
                 (vcmppd :eq (:zmm 1) (:zmm 2) (:zmm 3))
                 (vpcmpeqd (:zmm 1) (:zmm 2) (:zmm 3))
                 (vptest (:xmm 17) (:xmm 18))))
    (assertoid:assert-error (assemble-avx-test form))))

(test-util:with-test (:name :avx-permute-disassembly)
  (dolist (instruction '((vpermilpd (:zmm 17) (:zmm 26) 5)
                         (vpermilpd (:zmm 17) (:zmm 26) (:zmm 31))
                         (vshufpd (:zmm 17) (:zmm 26) (:zmm 31) 5)
                         (vmovddup (:zmm 17) (:zmm 26))
                         (vpunpcklqdq (:zmm 17) (:zmm 26) (:zmm 31))
                         (vpunpckhqdq (:zmm 17) (:zmm 26) (:zmm 31))))
    (let* ((bytes (assemble-avx-test instruction))
           (text (with-output-to-string (s)
                   (sb-sys:with-pinned-objects (bytes)
                     (sb-disassem:disassemble-memory
                      (sb-sys:sap-int (sb-sys:vector-sap bytes)) (length bytes)
                      :stream s)))))
      (assert (search (symbol-name (car instruction)) text))
      (dolist (reg (remove-if-not #'consp (cdr instruction)))
        (assert (search (format nil "ZMM~D" (second reg)) text))))))

(test-util:with-test (:name :avx-vsib-disassembly)
  (dolist (instruction '((vpgatherqq-z (:zmm 17) (:vsib 291 :zmm 4) 3)
                         (vpgatherqd-z (:ymm 17) (:vsib 291 :zmm 20) 3)
                         (vpscatterdq-z (:vsib 291 :ymm 20) (:zmm 17) 3)))
    (let* ((bytes (assemble-avx-test instruction))
           (text (with-output-to-string (s)
                   (sb-sys:with-pinned-objects (bytes)
                     (sb-disassem:disassemble-memory
                      (sb-sys:vector-sap bytes) (length bytes) :stream s)))))
      (dolist (arg (remove-if-not #'consp (cdr instruction)))
        (assert (search (if (eq (car arg) :vsib)
                            (format nil "~A~D*2" (third arg) (fourth arg))
                            (format nil "~A~D" (first arg) (second arg)))
                        text)))
      (assert (search "K3" text)))))

(test-util:with-test (:name :avx-rip-relative-immediate)
  (dolist (name '(vpalignr vpclmulqdq))
    (dolist (width '(:xmm :ymm :zmm))
      (let* ((segment (sb-assem:make-segment))
             (label (sb-assem:gen-label))
             (reg (get-fpr width 1)))
        (sb-assem:assemble (segment nil)
          (sb-assem:inst* name reg reg (rip-relative-ea label) 5)
          (sb-assem::%emit-label segment nil label))
        (sb-assem:finalize-segment segment)
        (let* ((length (sb-assem::segment-current-posn segment))
               (bytes (sb-assem:segment-buffer segment)))
          ;; Target is immediately after imm8, so the disp32 must be zero.
          (assert (every #'zerop (subseq bytes (- length 5) (1- length)))))))))
